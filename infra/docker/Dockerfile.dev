FROM node:22-alpine 

WORKDIR /app

COPY package*.json ./
RUN npm ci && npm cache clean --force

RUN apk add --no-cache python3 py3-pip git curl docker-cli

COPY requirements-dev.txt ./
RUN pip3 install --no-cache-dir -r requirements-dev.txt

COPY . .

ENV PYTHONPATH=/app

EXPOSE 3000

CMD ["npm", "run", "start:dev"]