FROM alpine:latest AS pmd-fetcher
RUN apk add --no-cache wget unzip
RUN wget https://github.com/pmd/pmd/releases/download/pmd_releases%2F7.0.0/pmd-dist-7.0.0-bin.zip -O pmd.zip \
    && unzip pmd.zip -d /opt/

FROM node:22-slim AS node-binaries

FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-21-jre-headless \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=node-binaries /usr/local/include/ /usr/local/include/
COPY --from=node-binaries /usr/local/lib/ /usr/local/lib/
COPY --from=node-binaries /usr/local/bin/ /usr/local/bin/

COPY --from=pmd-fetcher /opt/pmd-bin-7.0.0 /opt/pmd-bin-7.0.0
ENV PATH="$PATH:/opt/pmd-bin-7.0.0/bin"

RUN npm install -g pnpm yarn @biomejs/biome typescript eslint jest --force && npm cache clean --force

WORKDIR /app

COPY src/agents/code/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt --break-system-packages

COPY src/agents/code/ /app/

ENTRYPOINT ["python", "/app/main.py"]