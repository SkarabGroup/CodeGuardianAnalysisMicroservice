      'PAT has an invalid format',
    );
    expect(() => PersonalAccessToken.create('ghp_aaaaaaaaaaaaaaaaaaaaa')).toThrow(
      'PAT has an invalid format',
    );
    expect(() => PersonalAccessToken.create('ghp_#aaaaaaaaaaaaaaaaaaa')).toThrow(
      'PAT has an invalid format',
    );
