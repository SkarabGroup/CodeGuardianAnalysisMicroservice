    if (value.includes('\\')) {
      throw new Error('Path must not contain "\\". Use "/" separators');
    }

    if (value.includes('..')) {
      throw new Error('Path cannot contain ".."');
    }
  }

  public get value(): string {
    return this._value;
  }

  public equals(other: PathFinding): boolean {
    if (!(other instanceof PathFinding)) {
