    it('should throw if language is not supported by the enum', () => {
      expect(() =>
        StaticAnalysisFinding.create(VALID_PATH, VALID_CATEGORY, VALID_ERROR, 'CSHARP'),
      ).toThrow('Invalid analyzed language');
